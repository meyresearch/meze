source leaprc.gaff2
source oldff/leaprc.ff14SB
source leaprc.water.tip3p
addAtomTypes {
        { "M1"  "Zn" "sp3" }
        { "M2"  "Zn" "sp3" }
        { "Y1"  "N" "sp3" }
        { "Y2"  "N" "sp3" }
        { "Y3"  "N" "sp3" }
        { "Y4"  "O" "sp3" }
        { "Y5"  "O" "sp3" }
        { "Y6"  "S" "sp3" }
        { "Y7"  "N" "sp3" }
        { "Y8"  "O" "sp3" }
}
HD1 = loadmol2 HD1.mol2
HE1 = loadmol2 HE1.mol2
AP1 = loadmol2 AP1.mol2
HD2 = loadmol2 HD2.mol2
CM1 = loadmol2 CM1.mol2
HD3 = loadmol2 HD3.mol2
ZN1 = loadmol2 ZN1.mol2
ZN2 = loadmol2 ZN2.mol2
ML1 = loadmol2 ML1.mol2
MH1 = loadmol2 MH1.mol2
loadamberparams MOL.frcmod
loadamberparams MOH.frcmod
loadamberparams frcmod.ions1lm_126_tip3p
loadamberparams vim2_ligand_11_mcpbpy.frcmod
mol = loadpdb vim2_ligand_11_mcpbpy.pdb
bond mol.83.NE2 mol.233.ZN
bond mol.85.ND1 mol.233.ZN
bond mol.87.OD2 mol.234.ZN
bond mol.148.NE2 mol.233.ZN
bond mol.167.SG mol.234.ZN
bond mol.209.NE2 mol.234.ZN
bond mol.233.ZN mol.236.OH
bond mol.234.ZN mol.235.O20
bond mol.234.ZN mol.236.OH
bond mol.82.C mol.83.N
bond mol.83.C mol.84.N
bond mol.84.C mol.85.N
bond mol.85.C mol.86.N
bond mol.86.C mol.87.N
bond mol.87.C mol.88.N
bond mol.147.C mol.148.N
bond mol.148.C mol.149.N
bond mol.166.C mol.167.N
bond mol.167.C mol.168.N
bond mol.208.C mol.209.N
bond mol.209.C mol.210.N
savepdb mol vim2_ligand_11_dry.pdb
saveamberparm mol vim2_ligand_11_dry.prmtop vim2_ligand_11_dry.inpcrd
solvateoct mol TIP3PBOX 10.0 iso 0.75
addions mol Na+ 0
addions mol Cl- 0
savepdb mol vim2_ligand_11_solv.pdb
saveamberparm mol vim2_ligand_11_solv.prmtop vim2_ligand_11_solv.inpcrd
quit
 
