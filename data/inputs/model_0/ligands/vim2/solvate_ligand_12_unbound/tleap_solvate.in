source leaprc.gaff2
source leaprc.water.tip3p
loadamberparams frcmod.ions1lm_126_tip3p
loadamberparams /group/chem/oliveira2t/af25016/vim2-model-0//inputs/ligands/solvate_ligand_12_unbound/ligand_12.frcmod
lig = loadmol2 /group/chem/oliveira2t/af25016/vim2-model-0//inputs/ligands/solvate_ligand_12_unbound/ligand_12.mol2

solvateoct lig TIP3PBOX 12.0 iso 0.75
addions2 lig Na+ 0
addions2 lig Cl- 0

savepdb lig ligand_12_solv.pdb
saveamberparm lig ligand_12_solv.prmtop ligand_12_solv.inpcrd
quit