source oldff/leaprc.ff14SB
source leaprc.water.tip3p
loadamberparams frcmod.ions1lm_126_tip3p
protein = loadpdb /user/work/af25016/vim2-model-0//inputs/protein/vim2.fixed.pdb
source leaprc.gaff2
loadamberparams /user/work/af25016/vim2-model-0//inputs/protein/solvate_ligand_12_bound/ligand_12.frcmod
lig = loadmol2 /user/work/af25016/vim2-model-0//inputs/protein/solvate_ligand_12_bound/ligand_12.mol2

loadamberparams /user/work/af25016/vim2-model-0//inputs/protein/solvate_ligand_12_bound/MOH.frcmod
res = loadmol2 /user/work/af25016/vim2-model-0//inputs/protein/solvate_ligand_12_bound/MOH.mol2

complex = combine {protein res lig}
savepdb complex ligand_12_complex_dry.pdb
check complex

solvateoct complex TIP3PBOX 10.0 iso 0.75
addions2 complex Na+ 0
addions2 complex Cl- 0

savepdb complex ligand_12_complex_solv.pdb
saveamberparm complex ligand_12_complex_solv.prmtop ligand_12_complex_solv.inpcrd
quit