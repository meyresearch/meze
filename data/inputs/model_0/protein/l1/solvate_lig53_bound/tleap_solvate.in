source oldff/leaprc.ff14SB
source leaprc.water.tip3p
loadamberparams frcmod.ions1lm_126_tip3p
protein = loadpdb /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/l1.fixed.pdb
source leaprc.gaff2
loadamberparams /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/solvate_lig53_bound/lig53.frcmod
lig = loadmol2 /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/solvate_lig53_bound/lig53.mol2

loadamberparams /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/solvate_lig53_bound/MOH.frcmod
MOH = loadmol2 /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/solvate_lig53_bound/MOH.mol2

loadamberparams /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/solvate_lig53_bound/DOH.frcmod
DOH = loadmol2 /Users/af25016/projects/meze/data//inputs/model_0/protein/l1/solvate_lig53_bound/DOH.mol2

complex = combine {protein MOH DOH lig}
savepdb complex lig53_complex_dry.pdb
check complex

solvateoct complex TIP3PBOX 10.0 iso 0.75
addions2 complex Na+ 0
addions2 complex Cl- 0

savepdb complex lig53_complex_solv.pdb
saveamberparm complex lig53_complex_solv.prmtop lig53_complex_solv.inpcrd
quit