source oldff/leaprc.ff14SB
source leaprc.water.tip3p
loadamberparams frcmod.ions1lm_126_tip3p
protein = loadpdb /Users/af25016/projects/meze/data//inputs/model_0/protein/vim2.fixed.pdb
source leaprc.gaff2
loadamberparams /Users/af25016/projects/meze/data//inputs/model_0/protein/solvate_ligand_11_bound/ligand_11.frcmod
lig = loadmol2 /Users/af25016/projects/meze/data//inputs/model_0/protein/solvate_ligand_11_bound/ligand_11.mol2

loadamberparams /Users/af25016/projects/meze/data//inputs/model_0/protein/solvate_ligand_11_bound/MOH.frcmod
res = loadmol2 /Users/af25016/projects/meze/data//inputs/model_0/protein/solvate_ligand_11_bound/MOH.mol2

complex = combine {protein res lig}
savepdb complex ligand_11_complex_dry.pdb
check complex

solvateoct complex TIP3PBOX 10.0 iso 0.75
addions2 complex Na+ 0
addions2 complex Cl- 0

savepdb complex ligand_11_complex_solv.pdb
saveamberparm complex ligand_11_complex_solv.prmtop ligand_11_complex_solv.inpcrd
quit